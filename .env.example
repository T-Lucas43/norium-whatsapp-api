NODE_ENV=development
PORT=8080
SESSION_ID=norium
SESSION_DATA_PATH=./data/sessions
PERSISTENCE_ROOT=./data
PERSISTENCE_BLOB_URL=
PERSISTENCE_INTERVAL_SECONDS=30
CHROME_PATH=

# Use valores aleatorios diferentes com pelo menos 32 caracteres.
NORIUM_API_KEY=
ADMIN_API_KEY=
WEBHOOK_HMAC_SECRET=

# Callback que recebe eventos do WhatsApp no Norium.
NORIUM_WEBHOOK_URL=http://127.0.0.1:8000/api/whatsapp/webhook
NORIUM_WEBHOOK_SECRET=

# Seguranca e limites.
TRUST_PROXY=1
RATE_LIMIT_PER_MINUTE=120
SEND_RATE_LIMIT_PER_MINUTE=30
MAX_ACTIVE_SESSIONS=8
MAX_BODY_MB=25
ALLOWED_ORIGINS=
LOG_LEVEL=info

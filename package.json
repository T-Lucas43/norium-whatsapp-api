{
  "name": "norium-whatsapp-api",
  "version": "1.0.0",
  "private": true,
  "description": "API privada e endurecida para integrar OpenWA ao Norium.",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/session-manager.test.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@open-wa/wa-automate": "^4.76.0",
    "cors": "2.8.5",
    "express": "5.1.0",
    "express-rate-limit": "8.6.2",
    "helmet": "8.1.0",
    "pino": "9.9.0",
    "pino-http": "10.5.0",
    "qrcode": "^1.5.4",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/qrcode": "^1.5.5",
    "typescript": "5.9.2"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "@puppeteer/browsers": "3.2.1",
    "deepmerge-ts": "8.0.2",
    "file-type": "22.0.2",
    "got": "11.8.6",
    "image-size": "2.0.2",
    "js-yaml": "5.3.0",
    "postcss": "8.5.26",
    "puppeteer": "25.8.0",
    "puppeteer-core": "25.8.0",
    "sanitize-html": "2.17.7",
    "uuid": "14.0.2",
    "parse-url": "8.1.0",
    "@open-wa/wa-decrypt": {
      "axios": "1.19.0"
    },
    "localtunnel": {
      "axios": "1.19.0"
    },
    "patch-package": {
      "tmp": "0.2.7"
    },
    "postman-collection": {
      "lodash": "4.18.1",
      "marked": "4.3.0",
      "semver": "7.8.5"
    },
    "cacheable-request": {
      "http-cache-semantics": "4.2.0"
    },
    "swagger-stats": {
      "send": "0.19.2"
    }
  }
}

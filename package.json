{
  "name": "norium-whatsapp-api",
  "version": "1.0.0",
  "private": true,
  "description": "API privada e endurecida para integrar OpenWA ao Norium.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@open-wa/driver-puppeteer": "5.0.0-alpha.8",
    "@open-wa/wa-automate": "5.0.0-alpha.8",
    "cors": "2.8.5",
    "express": "5.1.0",
    "express-rate-limit": "8.6.2",
    "helmet": "8.1.0",
    "pino": "9.9.0",
    "pino-http": "10.5.0",
    "qrcode": "^1.5.4",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/qrcode": "^1.5.5",
    "typescript": "5.9.2"
  }
}
